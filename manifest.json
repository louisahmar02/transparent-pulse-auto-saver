{
  "manifest_version": 3,
  "name": "Transparent Pulse Auto Saver",
  "version": "1.2",
  "description": "Auto downloads Transparent Pulse certificates and uploads them directly to Google Drive.",
  "permissions": [
    "tabs",
    "activeTab",
    "identity",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://pulse.transparent.com/*"],
      "js": ["main_interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://pulse.transparent.com/*"],
      "js": ["content.js"],
      "world": "ISOLATED"
    }
  ],
  "oauth2": {
    "client_id": "1072452899972-l1j2g58kjpp85d2m0svvj31ornhv9fq1.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  }
}
